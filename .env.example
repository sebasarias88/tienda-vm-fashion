# Supabase (requerido en Vercel → Settings → Environment Variables)
# Usar estos nombres SIN prefijo NEXT_PUBLIC_ para evitar advertencias en Vercel.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# URL pública del sitio (requerido para SEO: canonical, sitemap, Open Graph)
# Ejemplo: https://tienda-vm-fashion.vercel.app
SITE_URL=

# Solo para scripts locales (nunca exponer al cliente)
# SUPABASE_SERVICE_ROLE_KEY=
