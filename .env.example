# Supabase (requerido en Vercel → Settings → Environment Variables)
# Usar estos nombres SIN prefijo NEXT_PUBLIC_ para evitar advertencias en Vercel.
# IMPORTANTE: la URL debe ser el MISMO proyecto donde están las imágenes en Storage
# (ej. https://xxxx.supabase.co — revisa una imagen_url en la tabla productos).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# URL pública del sitio (requerido para SEO: canonical, sitemap, Open Graph)
# Ejemplo: https://tienda-vm-fashion.vercel.app
SITE_URL=

# Solo para scripts locales (nunca exponer al cliente)
# SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (product/category/banner images) — server only, NEVER prefix with NEXT_PUBLIC_
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vmfashion-images
R2_PUBLIC_BASE_URL=https://img.tiendavmfashion.com

# Maintenance screen for the public catalog (true/false). Change it in Vercel and Redeploy.
MAINTENANCE_MODE=false
